# Bulutun ana adresi (kayıt ve ödeme sayfaları)
VK_CLOUD_URL=https://bulut.velariskasa.com
# İşletme adresleri: <adres>.velariskasa.com
VK_CLOUD_DOMAIN=velariskasa.com
# /yonetim sayfası parolası (uzun, rastgele)
VK_CLOUD_ADMIN_TOKEN=
# simulator: gerçek ödeme yok · iyzico: iyzico Ödeme Formu
VK_PAYMENT_PROVIDER=simulator
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Deneme: https://sandbox-api.iyzipay.com · Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
