{
  "name": "velaris-kasa",
  "version": "1.0.0",
  "description": "VelarisKasa - Stok takip ve kasa (POS) programı. Tek başına ya da Velaris CRM ile entegre çalışır.",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Velaris Dijital",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "jsbarcode": "^3.11.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "concurrently": "^10.0.6",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "opentype.js": "^1.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sql.js": "^1.15.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "NODE_ENV=test VK_TEST_DEFAULT_PLAN=pro node --test test/*.test.js",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "demo:build": "node scripts/build-demo.mjs",
    "license:issue": "node scripts/license.mjs issue"
  },
  "build": {
    "appId": "com.velarisdijital.velariskasa",
    "productName": "VelarisKasa",
    "copyright": "Velaris Dijital",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "package.json",
      "!**/*.map",
      "!server/data/off-raw.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VelarisKasa",
      "language": "1055"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icon.png",
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.business"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
